VMQ_BIND_ADDRESS=0.0.0.0
VMQ_HTTP_PORT=18473

# 每项都请换成独立的随机长字符串，不要提交 .env。
VMQ_DB_PASSWORD=replace-with-a-long-random-password
VMQ_DB_ROOT_PASSWORD=replace-with-another-long-random-password
VMQ_ADMIN_PASSWORD=replace-with-a-strong-admin-password
VMQ_API_KEY=replace-with-a-random-app-key-at-least-32-chars

# 填你的 Cloudflare 业务服务 HTTPS 地址；CF 端成功时必须原样返回 success。
VMQ_NOTIFY_URL=
VMQ_RETURN_URL=
VMQ_CALLBACK_SECRET=replace-with-a-different-random-callback-secret

# 本机局域网 HTTP 保持 false；若后台只通过 HTTPS 访问则改 true。
VMQ_COOKIE_SECURE=false

# 默认禁止调用方临时替换回调地址，避免订单接口被利用发起 SSRF。
VMQ_ALLOW_ORDER_CALLBACK_OVERRIDE=false
